<Window x:Class="Tokenometer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tokenometer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tokenometer"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#01000000"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource InkBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Animated"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="32"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="ActionBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFF916F" Offset="0" />
            <GradientStop Color="#FFFF6244" Offset="0.55" />
            <GradientStop Color="#FFEB3F8F" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="HeaderCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#3EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EFF8FFFF" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#32FFFFFF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A8FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="17,0" />
            <Setter Property="Background" Value="{StaticResource ActionBrush}" />
            <Setter Property="BorderBrush" Value="#D8FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF674D" BlurRadius="18" ShadowDepth="5" Opacity="0.35" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#B9CDDBE7" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectedSegmentStyle" TargetType="Button" BasedOn="{StaticResource SegmentStyle}">
            <Setter Property="Background" Value="#E8FFFFFF" />
            <Setter Property="Foreground" Value="#15191E" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="InnerCellStyle" TargetType="Border">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#34FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="BottomNavButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderCircleButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#CFDFEAF3" />
        </Style>

        <Style x:Key="SelectedBottomNavButtonStyle" TargetType="Button" BasedOn="{StaticResource BottomNavButtonStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="#EFFFFFFF" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Foreground" Value="#15191E" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowShell"
            Background="#10000000"
            BorderBrush="{StaticResource LiquidEdgeBrush}"
            BorderThickness="1"
            CornerRadius="32"
            ClipToBounds="True">
        <Grid>
            <!-- This layer is neutral; the actual color comes from the system Acrylic backdrop. -->
            <Grid x:Name="BackdropScene" Background="#02000000" IsHitTestVisible="False" />

            <Grid Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header follows the reference: identity left, actions right. -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#18FFFFFF"
                                BorderBrush="#86FFFFFF" BorderThickness="1">
                            <Grid>
                                <Ellipse Width="26" Height="26" Stroke="White" StrokeThickness="1.5" />
                                <Path Data="M 8,19 C 11,9 20,8 28,15 C 32,19 29,28 22,30"
                                      Stretch="Uniform" Stroke="White" Opacity="0.82" StrokeThickness="2" />
                                <Ellipse Width="5" Height="5" Fill="{StaticResource CoralBrush}" Margin="14,-14,0,0" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Tokenometer" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource LimeBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding SourceLabel}" FontSize="9.5" Foreground="#AFC6D5E1" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ActionButtonStyle}" AutomationProperties.Name="显示桌面组件" Click="Widget_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Add widget" />
                                <TextBlock Margin="8,0,0,0" FontSize="18" FontWeight="Normal" Text="+" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HeaderCircleButtonStyle}" ToolTip="通知（接口已保留）" AutomationProperties.Name="通知" Click="ReservedButton_Click" Content="&#xE7F4;" />
                        <Button Style="{StaticResource HeaderCircleButtonStyle}" ToolTip="立即刷新" AutomationProperties.Name="立即刷新" Click="Refresh_Click" Content="&#xE72C;" />
                        <Button Style="{StaticResource HeaderCircleButtonStyle}" ToolTip="搜索（接口已保留）" AutomationProperties.Name="搜索" Click="ReservedButton_Click" Content="&#xE721;" />
                        <Button Style="{StaticResource HeaderCircleButtonStyle}" ToolTip="最小化" AutomationProperties.Name="最小化到桌面组件" Click="Minimize_Click" Content="&#xE921;" />
                        <Button Style="{StaticResource HeaderCircleButtonStyle}" ToolTip="最大化" AutomationProperties.Name="最大化窗口" Click="Maximize_Click" Content="&#xE922;" />
                        <Button Style="{StaticResource HeaderCircleButtonStyle}" ToolTip="关闭" AutomationProperties.Name="隐藏到桌面组件" Click="Close_Click" Content="&#xE8BB;" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Padding="0,0,6,58"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MinHeight="612">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="292" />
                            <ColumnDefinition Width="*" MinWidth="430" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="238" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="226" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="116" />
                        </Grid.RowDefinitions>

                        <!-- Left / top: allowance gauge -->
                        <controls:BackdropGlass Grid.Row="0" Grid.Column="0"
                                                Style="{StaticResource LiquidContentSurfaceStyle}"
                                                BackdropVisual="{Binding ElementName=BackdropScene}"
                                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="配额剩余" FontSize="15.5" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding RemainingDisplay}" HorizontalAlignment="Right" FontSize="29" FontWeight="SemiBold" Foreground="White" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,3,0,-4">
                                    <controls:QuotaRing Value="{Binding AllowanceRemainingRatio}" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,13">
                                        <TextBlock Text="{Binding AllowanceWindowLabel}" FontSize="10" Foreground="#C4D6E3ED" HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding ResetDisplay}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource LimeBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SourceBadge}" FontSize="9" FontWeight="SemiBold" Foreground="#C8DDEAF4" />
                                </StackPanel>
                            </Grid>
                        </controls:BackdropGlass>

                        <!-- Center / top: primary trend -->
                        <controls:BackdropGlass x:Name="TrendGlass" Grid.Row="0" Grid.Column="1" Margin="16,0"
                                                Style="{StaticResource LiquidGlassSurfaceStyle}"
                                                BackdropVisual="{Binding ElementName=BackdropScene}"
                                                Padding="20,17">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="会话用量趋势" FontSize="15.5" FontWeight="SemiBold" Foreground="White" />
                                        <Border Margin="9,0,0,0" Padding="8,3" Background="#12FFFFFF" BorderBrush="#34FFFFFF" BorderThickness="1" CornerRadius="10">
                                            <TextBlock Text="{Binding CurrentModel}" FontSize="9" Foreground="#D6E7F2FA" />
                                        </Border>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Padding="3" Background="#10000000" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="15">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegmentStyle}" Content="1m" />
                                            <Button Style="{StaticResource SegmentStyle}" Content="5m" Click="ReservedButton_Click" />
                                            <Button Style="{StaticResource SelectedSegmentStyle}" Content="Session" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding CurrentTotalDisplay}" FontSize="35" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text=" tokens" Margin="5,0,0,7" FontSize="11" Foreground="#ADC6D6E3" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding UpdatedDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9.5" Foreground="#91AFC2D1" />
                                </Grid>
                                <controls:TokenTrendChart Grid.Row="2" Values="{Binding Trend}" Margin="-4,3,-4,-3" />
                            </Grid>
                        </controls:BackdropGlass>

                        <!-- Right overview spans the two major rows. -->
                        <controls:BackdropGlass Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                                                Style="{StaticResource LiquidGlassSurfaceStyle}"
                                                BackdropVisual="{Binding ElementName=BackdropScene}"
                                                BlurRadius="34"
                                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="76" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="用量总览" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Margin="0,3,0,0" Text="TODAY" FontSize="9" FontWeight="SemiBold" Foreground="#90AFC2D1" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Padding="9,5" Background="#16FFFFFF" BorderBrush="#36FFFFFF" BorderThickness="1" CornerRadius="13">
                                        <TextBlock Text="{Binding SourceBadge}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource LimeBrush}" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,2" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding TodayTotalDisplay}" FontSize="32" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text=" tokens" Margin="5,0,0,7" FontSize="10" Foreground="#AFC6D5E1" />
                                </StackPanel>
                                <controls:TokenTrendChart Grid.Row="2" Values="{Binding Trend}" Margin="-8,1,-6,0" />
                                <controls:TokenCompositionBar Grid.Row="3" Height="9" Margin="0,13,0,14"
                                                              Input="{Binding CurrentInputTokens}"
                                                              Cached="{Binding CurrentCachedInputTokens}"
                                                              Output="{Binding CurrentOutputTokens}" />
                                <Grid Grid.Row="4" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource InnerCellStyle}" Margin="0,0,5,0">
                                        <StackPanel>
                                            <TextBlock Text="CONTEXT" FontSize="8.5" Foreground="#91B0C3D2" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding ContextDisplay}" FontSize="21" FontWeight="SemiBold" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource InnerCellStyle}" Margin="5,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="CHANGE" FontSize="8.5" Foreground="#91B0C3D2" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding TodayChangeDisplay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource LimeBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="5">
                                    <TextBlock Text="Token 分布" Margin="0,0,0,7" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                    <Grid Margin="0,0,0,8">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource CyanBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Text="输入" Margin="14,0,0,0" FontSize="10.5" Foreground="#C1D4E1EB" />
                                        <TextBlock Text="{Binding InputDisplay}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource MintBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Text="缓存命中" Margin="14,0,0,0" FontSize="10.5" Foreground="#C1D4E1EB" />
                                        <TextBlock Text="{Binding CachedDisplay}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </Grid>
                                    <Grid>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource VioletBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Text="输出" Margin="14,0,0,0" FontSize="10.5" Foreground="#C1D4E1EB" />
                                        <TextBlock Text="{Binding OutputDisplay}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Row="6" Height="34" Margin="0,12,0,0" Background="#18FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1"
                                        Foreground="White" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" Click="ReservedButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#32FFFFFF" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="查看全部会话  ›" />
                                </Button>
                            </Grid>
                        </controls:BackdropGlass>

                        <!-- Left / middle: current breakdown -->
                        <controls:BackdropGlass Grid.Row="2" Grid.Column="0"
                                                Style="{StaticResource LiquidContentSurfaceStyle}"
                                                BackdropVisual="{Binding ElementName=BackdropScene}"
                                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="当前会话" FontSize="15.5" FontWeight="SemiBold" Foreground="White" />
                                    <Border HorizontalAlignment="Right" Padding="8,3" Background="#12FFFFFF" CornerRadius="10">
                                        <TextBlock Text="{Binding CurrentModel}" FontSize="8.5" Foreground="#D3E4EFF7" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding CurrentTotalDisplay}" FontSize="35" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text=" tokens" Margin="4,0,0,7" FontSize="10" Foreground="#AFC7D7E3" />
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <Grid Margin="0,0,0,8"><TextBlock Text="INPUT" FontSize="9" Foreground="#91B0C3D2" /><TextBlock Text="{Binding InputDisplay}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" /></Grid>
                                    <Grid Margin="0,0,0,8"><TextBlock Text="CACHE" FontSize="9" Foreground="#91B0C3D2" /><TextBlock Text="{Binding CachedDisplay}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}" /></Grid>
                                    <Grid><TextBlock Text="OUTPUT" FontSize="9" Foreground="#91B0C3D2" /><TextBlock Text="{Binding OutputDisplay}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource VioletBrush}" /></Grid>
                                </StackPanel>
                                <Grid Grid.Row="3" Margin="0,13,0,0">
                                    <ProgressBar Height="7" Style="{StaticResource SmallProgressStyle}" Maximum="1" Value="{Binding ContextRatio, Mode=OneWay}" />
                                    <TextBlock Text="{Binding ContextDisplay}" Margin="0,11,0,0" HorizontalAlignment="Right" FontSize="9.5" FontWeight="SemiBold" Foreground="White" />
                                </Grid>
                            </Grid>
                        </controls:BackdropGlass>

                        <!-- Center / middle: short-window pulse -->
                        <controls:BackdropGlass Grid.Row="2" Grid.Column="1" Margin="16,0"
                                                Style="{StaticResource LiquidContentSurfaceStyle}"
                                                BackdropVisual="{Binding ElementName=BackdropScene}"
                                                Padding="20,17">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Token pulse" FontSize="15.5" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Margin="0,3,0,0" Text="1 / 5 分钟增量监看" FontSize="9.5" Foreground="#9DB8CAD8" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Padding="9,4" Background="#12FFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="12">
                                            <TextBlock Text="ROLLING · 60s" FontSize="8.5" Foreground="#D2E2EDF5" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <controls:TokenPulseChart Grid.Row="1" Values="{Binding Pulse}" Margin="0,12,0,6" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource CyanBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="输入 / 缓存" FontSize="9.5" Foreground="#C1D4E1EB" />
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource VioletBrush}" Margin="18,0,6,0" />
                                    <TextBlock Text="模型输出" FontSize="9.5" Foreground="#C1D4E1EB" />
                                </StackPanel>
                            </Grid>
                        </controls:BackdropGlass>

                        <!-- Bottom left: quick actions -->
                        <controls:BackdropGlass Grid.Row="4" Grid.Column="0"
                                                Style="{StaticResource LiquidContentSurfaceStyle}"
                                                BackdropVisual="{Binding ElementName=BackdropScene}"
                                                CornerRadius="22" Padding="17,12">
                            <Grid>
                                <TextBlock Text="快捷操作" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Top" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource HeaderCircleButtonStyle}" ToolTip="刷新" AutomationProperties.Name="刷新用量" Click="Refresh_Click" Content="&#xE72C;" />
                                    <Button Style="{StaticResource HeaderCircleButtonStyle}" ToolTip="桌面组件" AutomationProperties.Name="显示桌面组件" Click="Widget_Click" Content="&#xE7F4;" />
                                    <Button Style="{StaticResource HeaderCircleButtonStyle}" ToolTip="设置（接口已保留）" AutomationProperties.Name="设置" Click="ReservedButton_Click" Content="&#xE713;" />
                                </StackPanel>
                            </Grid>
                        </controls:BackdropGlass>

                        <!-- Bottom center: recent sessions -->
                        <controls:BackdropGlass Grid.Row="4" Grid.Column="1" Margin="16,0"
                                                Style="{StaticResource LiquidContentSurfaceStyle}"
                                                BackdropVisual="{Binding ElementName=BackdropScene}"
                                                CornerRadius="22" Padding="17,12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="最近会话" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="查看全部  ›" HorizontalAlignment="Right" FontSize="9.5" Foreground="#B5C9D8E4" />
                                </Grid>
                                <ItemsControl Grid.Row="1" Margin="0,9,0,0" ItemsSource="{Binding RecentSessions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,7,0" Padding="9,7" Background="#0EFFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1" CornerRadius="12">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Model}" FontSize="8" Foreground="#8EAEC1D0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TotalTokens, StringFormat={}{0:N0}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="10" FontWeight="SemiBold" Foreground="#D8E8F2F9" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </controls:BackdropGlass>

                        <!-- Bottom right: source freshness -->
                        <controls:BackdropGlass Grid.Row="4" Grid.Column="2"
                                                Style="{StaticResource LiquidContentSurfaceStyle}"
                                                BackdropVisual="{Binding ElementName=BackdropScene}"
                                                CornerRadius="22" Padding="17,12">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="数据状态" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Margin="0,5,0,0" Text="{Binding SourceLabel}" FontSize="9.5" Foreground="#B8CDDBE6" />
                                    <TextBlock Margin="0,2,0,0" Text="{Binding UpdatedDisplay}" FontSize="8.5" Foreground="#87A7BBCB" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,5" Background="#16FFFFFF" BorderBrush="#34FFFFFF" BorderThickness="1" CornerRadius="13">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource LimeBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="READY" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource LimeBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </controls:BackdropGlass>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Floating bottom navigation, matching the reference layout. -->
            <controls:BackdropGlass Width="344" Height="54"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                                    Style="{StaticResource LiquidCapsuleSurfaceStyle}"
                                    BackdropVisual="{Binding ElementName=BackdropScene}"
                                    Padding="7,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource BottomNavButtonStyle}" ToolTip="日历（接口已保留）" AutomationProperties.Name="日历" Click="ReservedButton_Click" Content="&#xE787;" />
                    <Button Style="{StaticResource BottomNavButtonStyle}" ToolTip="搜索（接口已保留）" AutomationProperties.Name="搜索" Click="ReservedButton_Click" Content="&#xE721;" />
                    <Button Style="{StaticResource SelectedBottomNavButtonStyle}" ToolTip="Overview" AutomationProperties.Name="用量概览（当前）" Content="&#xE80F;" />
                    <Button Style="{StaticResource BottomNavButtonStyle}" ToolTip="会话" AutomationProperties.Name="会话" Click="ReservedButton_Click" Content="&#xE8A5;" />
                    <Button Style="{StaticResource BottomNavButtonStyle}" ToolTip="设置" AutomationProperties.Name="设置" Click="ReservedButton_Click" Content="&#xE713;" />
                </StackPanel>
            </controls:BackdropGlass>

            <controls:BackdropGlass x:Name="FeatureToast"
                                    Width="330" Height="46" Opacity="0" IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76"
                                    Style="{StaticResource LiquidCapsuleSurfaceStyle}"
                                    BackdropVisual="{Binding ElementName=BackdropScene}"
                                    Padding="15,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,8,0" />
                    <TextBlock x:Name="FeatureToastText" Text="接口已保留" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </controls:BackdropGlass>
        </Grid>
    </Border>
</Window>
