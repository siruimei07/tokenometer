<Window x:Class="Tokenometer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tokenometer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tokenometer"
        Width="1220"
        Height="790"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#01FFFFFF"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="30"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource CanvasBrush}">
        <Ellipse Width="540" Height="540" Margin="-210,-220,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#78A9B5FF" Offset="0" />
                    <GradientStop Color="#00A9B5FF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="620" Height="620" Margin="0,0,-260,-330" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#68FFD1DA" Offset="0" />
                    <GradientStop Color="#00FFD1DA" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="420" Height="420" Margin="0,40,140,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5BC9F4E8" Offset="0" />
                    <GradientStop Color="#00C9F4E8" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Border x:Name="WindowShell"
                Margin="16"
                Background="{StaticResource ShellBrush}"
                BorderBrush="#DFFFFFFF"
                BorderThickness="1"
                CornerRadius="30"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#5E6E91" BlurRadius="36" ShadowDepth="10" Opacity="0.22" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#4AFFFFFF" BorderBrush="#72FFFFFF" BorderThickness="0,0,1,0">
                    <Grid Margin="0,16,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Width="46" Height="46" CornerRadius="17" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Center" ToolTip="Tokenometer">
                            <Grid>
                                <Ellipse Width="20" Height="20" Stroke="White" StrokeThickness="2.2" />
                                <Ellipse Width="4" Height="4" Fill="White" Margin="0,-11,0,0" />
                                <Ellipse Width="4" Height="4" Fill="White" Margin="-10,7,0,0" />
                                <Ellipse Width="4" Height="4" Fill="White" Margin="10,7,0,0" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource SidebarRadioStyle}" IsChecked="True" GroupName="Navigation" ToolTip="用量概览">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="18" Text="&#xE80F;" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Navigation" ToolTip="会话记录" Checked="ReservedNavigation_Checked">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="18" Text="&#xE8A5;" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Navigation" ToolTip="模型分析" Checked="ReservedNavigation_Checked">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="18" Text="&#xE9D2;" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Navigation" ToolTip="数据源" Checked="ReservedNavigation_Checked">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="18" Text="&#xE8B7;" />
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Button Style="{StaticResource IconButtonStyle}" Width="46" Height="46" Margin="15,0"
                                    Background="Transparent" BorderBrush="Transparent" ToolTip="外观与设置"
                                    Click="ReservedButton_Click" Content="&#xE713;" />
                            <Border Width="32" Height="1" Background="#60919AAD" Margin="0,10" />
                            <Border Width="34" Height="34" CornerRadius="17" Background="#CFFFFFFF" HorizontalAlignment="Center"
                                    BorderBrush="#F4FFFFFF" BorderThickness="1" ToolTip="本地用户">
                                <TextBlock Text="S" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="22,12,16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="66" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="用量概览" FontFamily="{StaticResource AppFont}" FontSize="25" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" />
                                <Border Margin="12,4,0,0" Padding="8,3" Height="24" Background="#BCFFFFFF"
                                        BorderBrush="#EFFFFFFF" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource MintBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding SourceBadge}" FontFamily="{StaticResource AppFont}" FontSize="10.5"
                                                   FontWeight="SemiBold" Foreground="{StaticResource SecondaryInkBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,2,0,0" Text="Codex 使用节奏、会话上下文与配额状态" FontFamily="{StaticResource AppFont}"
                                       FontSize="12.5" Foreground="{StaticResource SecondaryInkBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border Margin="0,0,10,0" Padding="12,7" Background="#72FFFFFF" BorderBrush="#AFFFFFFF"
                                    BorderThickness="1" CornerRadius="16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE895;" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding SourceLabel}" FontFamily="{StaticResource AppFont}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding UpdatedDisplay}" FontFamily="{StaticResource AppFont}" FontSize="9.5" Foreground="{StaticResource TertiaryInkBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0" ToolTip="立即刷新" Click="Refresh_Click" Content="&#xE72C;" />
                            <Button Style="{StaticResource WindowButtonStyle}" ToolTip="最小化" Click="Minimize_Click" Content="&#xE921;" />
                            <Button Style="{StaticResource WindowButtonStyle}" ToolTip="最大化" Click="Maximize_Click" Content="&#xE922;" />
                            <Button Style="{StaticResource WindowButtonStyle}" ToolTip="关闭" Click="Close_Click" Content="&#xE8BB;" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,2,8,0">
                        <Grid x:Name="DashboardGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.02*" MinWidth="245" />
                                <ColumnDefinition Width="1.58*" MinWidth="360" />
                                <ColumnDefinition Width="1.08*" MinWidth="265" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="238" />
                                <RowDefinition Height="292" />
                                <RowDefinition Height="116" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,14,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="配额余量" Style="{StaticResource CardTitleStyle}" />
                                        <Border HorizontalAlignment="Right" Padding="8,3" Background="#60FFFFFF" CornerRadius="10">
                                            <TextBlock Text="{Binding AllowanceWindowLabel}" Style="{StaticResource MetricLabelStyle}" FontSize="10.5" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1" Width="140" Height="140" HorizontalAlignment="Center" Margin="0,0,0,-4">
                                        <controls:QuotaRing Value="{Binding AllowanceRemainingRatio}" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding RemainingDisplay}" FontFamily="{StaticResource AppFont}" FontSize="31" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="剩余" FontFamily="{StaticResource AppFont}" FontSize="11.5" Foreground="{StaticResource SecondaryInkBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <TextBlock Text="{Binding ResetDisplay}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="演示值" Style="{StaticResource MetricLabelStyle}" FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource TertiaryInkBrush}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassCardStyle}" Margin="0,0,14,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource MintBrush}" Margin="0,0,7,0" />
                                            <TextBlock Text="当前会话" Style="{StaticResource CardTitleStyle}" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Padding="9,4" Background="#66FFFFFF" CornerRadius="11">
                                            <TextBlock Text="{Binding CurrentModel}" FontFamily="{StaticResource AppFont}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,1">
                                        <TextBlock Text="{Binding CurrentTotalDisplay}" FontFamily="{StaticResource AppFont}" FontSize="31" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text=" tokens" FontFamily="{StaticResource AppFont}" FontSize="12" Margin="4,14,0,0"
                                                   Foreground="{StaticResource SecondaryInkBrush}" />
                                    </StackPanel>
                                    <controls:TokenTrendChart Grid.Row="2" Values="{Binding Trend}" Margin="-4,0,-4,0" />
                                    <Grid Grid.Row="3" Margin="4,1,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource CyanBrush}" Margin="0,0,5,0" />
                                            <TextBlock Text="输入 " Style="{StaticResource MetricLabelStyle}" FontSize="10.5" />
                                            <TextBlock Text="{Binding InputDisplay}" Style="{StaticResource MetricLabelStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource MintBrush}" Margin="0,0,5,0" />
                                            <TextBlock Text="缓存 " Style="{StaticResource MetricLabelStyle}" FontSize="10.5" />
                                            <TextBlock Text="{Binding CachedDisplay}" Style="{StaticResource MetricLabelStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource VioletBrush}" Margin="0,0,5,0" />
                                            <TextBlock Text="输出 " Style="{StaticResource MetricLabelStyle}" FontSize="10.5" />
                                            <TextBlock Text="{Binding OutputDisplay}" Style="{StaticResource MetricLabelStyle}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="今日用量" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="{Binding TodayChangeDisplay, StringFormat=↑ {0}}" HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="10.5"
                                                   Foreground="{StaticResource MintBrush}" FontWeight="SemiBold" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,17,0,12">
                                        <TextBlock Text="{Binding TodayTotalDisplay}" FontFamily="{StaticResource AppFont}" FontSize="31" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text=" tokens" FontFamily="{StaticResource AppFont}" FontSize="12" Margin="4,14,0,0" Foreground="{StaticResource SecondaryInkBrush}" />
                                    </StackPanel>
                                    <controls:TokenCompositionBar Grid.Row="2" Height="10" Input="{Binding CurrentInputTokens, FallbackValue=68440}"
                                                                  Cached="{Binding CurrentCachedInputTokens, FallbackValue=41760}"
                                                                  Output="{Binding CurrentOutputTokens, FallbackValue=16180}" />
                                    <StackPanel Grid.Row="3" Margin="0,15,0,0">
                                        <Grid Margin="0,0,0,9">
                                            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource CyanBrush}" Margin="0,0,7,0" /><TextBlock Text="输入" Style="{StaticResource MetricLabelStyle}" /></StackPanel>
                                            <TextBlock Text="{Binding InputDisplay}" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,0,0,9">
                                            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource MintBrush}" Margin="0,0,7,0" /><TextBlock Text="缓存输入" Style="{StaticResource MetricLabelStyle}" /></StackPanel>
                                            <TextBlock Text="{Binding CachedDisplay}" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource VioletBrush}" Margin="0,0,7,0" /><TextBlock Text="输出" Style="{StaticResource MetricLabelStyle}" /></StackPanel>
                                            <TextBlock Text="{Binding OutputDisplay}" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GlassCardStyle}" Margin="0,0,14,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Token pulse" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="最近 5 分钟 · 悬停查看精确用量" Style="{StaticResource MetricLabelStyle}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#66FFFFFF" CornerRadius="14" Padding="4">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#E8FFFFFF" BorderBrush="#F9FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,5">
                                                    <TextBlock Text="5 分钟" FontFamily="{StaticResource AppFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                                </Border>
                                                <Button Style="{StaticResource BaseButtonStyle}" Tag="10" BorderThickness="0" Background="Transparent" Padding="10,5"
                                                        FontSize="10.5" Content="1 分钟" Click="ReservedButton_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1" Style="{StaticResource GlassInnerStyle}" Margin="0,14,0,12" Padding="13,12">
                                        <controls:TokenPulseChart Values="{Binding Pulse}" />
                                    </Border>
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0"><Ellipse Width="7" Height="7" Fill="{StaticResource CyanBrush}" Margin="0,0,6,0" /><TextBlock Text="输入" Style="{StaticResource MetricLabelStyle}" FontSize="10.5" /></StackPanel>
                                            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource VioletBrush}" Margin="0,0,6,0" /><TextBlock Text="输出" Style="{StaticResource MetricLabelStyle}" FontSize="10.5" /></StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="上下文 " Style="{StaticResource MetricLabelStyle}" FontSize="10.5" />
                                            <TextBlock Text="{Binding ContextDisplay}" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" FontSize="10.5" />
                                            <ProgressBar Width="74" Margin="8,0,0,0" Style="{StaticResource SmallProgressStyle}" Value="{Binding ContextRatio, Mode=OneWay}" Maximum="1" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="最近会话" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="按更新时间排序" Style="{StaticResource MetricLabelStyle}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButtonStyle}" Width="32" Height="32"
                                                Background="#54FFFFFF" ToolTip="查看全部" Click="ReservedButton_Click" Content="&#xE72A;" />
                                    </Grid>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentSessions}" Margin="0,11,0,7">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#42FFFFFF" BorderBrush="#62FFFFFF" BorderThickness="1" CornerRadius="13" Padding="9,6" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="22" Height="22" CornerRadius="7" Background="{Binding Accent}" VerticalAlignment="Center">
                                                            <Ellipse Width="6" Height="6" Fill="White" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="7,0,5,0">
                                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource AppFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Model}" FontFamily="{StaticResource AppFont}" FontSize="9.5" Foreground="{StaticResource TertiaryInkBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding TotalTokens, StringFormat={}{0:N0}}" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="tokens" FontFamily="{StaticResource AppFont}" FontSize="9" Foreground="{StaticResource TertiaryInkBrush}" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Grid.Row="2" Style="{StaticResource PillButtonStyle}" Height="34" FontSize="11" Content="打开会话记录" Click="ReservedButton_Click" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.15*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="数据源就绪度" Style="{StaticResource CardTitleStyle}" FontSize="13.5" />
                                        <TextBlock Text="真实值接入前保持明确的可用状态" Style="{StaticResource MetricLabelStyle}" FontSize="10.5" Margin="0,3,12,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource GlassInnerStyle}" Margin="4,0,8,0" Padding="11,9">
                                        <Grid>
                                            <Border Width="28" Height="28" CornerRadius="9" Background="#AEECF8FF" HorizontalAlignment="Left">
                                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="38,0,0,0">
                                                <TextBlock Text="本地会话" FontFamily="{StaticResource AppFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="JSONL 接口已保留" FontFamily="{StaticResource AppFont}" FontSize="9.5" Foreground="{StaticResource SecondaryInkBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource GlassInnerStyle}" Margin="0,0,8,0" Padding="11,9">
                                        <Grid>
                                            <Border Width="28" Height="28" CornerRadius="9" Background="#AEF0ECFF" HorizontalAlignment="Left">
                                                <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="38,0,0,0">
                                                <TextBlock Text="配额窗口" FontFamily="{StaticResource AppFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="app-server 可选" FontFamily="{StaticResource AppFont}" FontSize="9.5" Foreground="{StaticResource SecondaryInkBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource GlassInnerStyle}" Padding="11,9">
                                        <Grid>
                                            <Border Width="28" Height="28" CornerRadius="9" Background="#AEECFAF4" HorizontalAlignment="Left">
                                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="38,0,0,0">
                                                <TextBlock Text="隐私保护" FontFamily="{StaticResource AppFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="不读取会话正文与凭据" FontFamily="{StaticResource AppFont}" FontSize="9.5" Foreground="{StaticResource SecondaryInkBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <Border x:Name="FeatureToast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                            Padding="14,9" Background="#EB172033" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="16"
                            Opacity="0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock x:Name="FeatureToastText" Text="数据接入后启用" FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="White" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
