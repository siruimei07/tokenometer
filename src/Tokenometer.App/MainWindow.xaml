<Window x:Class="Tokenometer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tokenometer"
        Width="1120"
        Height="720"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#EEF0FA">
    <Grid>
        <Border Margin="24"
                Padding="32"
                Background="#CCFFFFFF"
                BorderBrush="#BFFFFFFF"
                BorderThickness="1"
                CornerRadius="28">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="20" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="T" FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                               FontSize="28" Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Margin="0,20,0,8" Text="Tokenometer" FontFamily="{StaticResource AppFont}"
                           FontSize="32" FontWeight="SemiBold" Foreground="#182032" />
                <TextBlock Text="Liquid Glass UI foundation" FontFamily="{StaticResource AppFont}"
                           FontSize="15" Foreground="#687083" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

