<Window x:Class="Tokenometer.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tokenometer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tokenometer Widget"
        Width="366"
        Height="236"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#01000000"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource InkBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="HighQuality">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="28"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WidgetIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="29" />
            <Setter Property="Height" Value="29" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#42FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAF7FFFF" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#38FFFFFF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#AAFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WidgetRoot" CornerRadius="28" ClipToBounds="True" Background="#01000000">
        <Grid x:Name="DragSurface" Background="Transparent" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
            <!-- Hue comes from the live desktop; this layer adds no color or pattern. -->
            <Grid x:Name="WidgetBackdropScene" Background="#02000000" IsHitTestVisible="False" />

            <controls:BackdropGlass x:Name="WidgetShell"
                                    Style="{StaticResource LiquidGlassSurfaceStyle}"
                                    BackdropVisual="{Binding ElementName=WidgetBackdropScene}"
                                    CornerRadius="28"
                                    BlurRadius="30"
                                    LensWidth="10"
                                    RefractionDepth="3.6"
                                    RefractionOpacity="0.78"
                                    HoverScale="1"
                                    Padding="15,13">
                <Grid>
                    <Image x:Name="SkinDecorationSlot" Opacity="0.16" Stretch="Uniform" Visibility="Collapsed"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" />

                    <Grid x:Name="ExpandedPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="76" />
                            <RowDefinition Height="66" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#26FFFFFF"
                                        BorderBrush="#96FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Ellipse Width="18" Height="18" Stroke="#F4FFFFFF" StrokeThickness="1.4" />
                                        <Path Data="M 7,15 C 9,9 15,7 21,11 C 25,14 24,21 19,23"
                                              Stretch="Uniform" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.7" />
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource CoralBrush}" Margin="10,-9,0,0" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Tokenometer" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource LimeBrush}" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding SourceBadge}" FontSize="8.5" FontWeight="SemiBold" Foreground="#B9D2E1ED" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource WidgetIconButtonStyle}" ToolTip="折叠" AutomationProperties.Name="折叠桌面组件" Click="Collapse_Click" Content="&#xE70D;" />
                                <Button Style="{StaticResource WidgetIconButtonStyle}" Margin="5,0,0,0" ToolTip="隐藏组件" AutomationProperties.Name="隐藏桌面组件" Click="Hide_Click" Content="&#xE8BB;" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="2,6,1,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CURRENT SESSION" FontSize="9" FontWeight="SemiBold" Foreground="#9DBFD2E1" />
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding CurrentTotalDisplay}" FontSize="31" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text=" tokens" FontSize="9.5" Margin="4,13,0,0" Foreground="#AEC9D8E4" />
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentModel}" FontSize="9.5" Foreground="{StaticResource CyanBrush}" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#16FFFFFF" BorderBrush="#3CFFFFFF" BorderThickness="1" CornerRadius="17">
                                <Grid>
                                    <controls:QuotaRing Width="84" Height="72" Value="{Binding AllowanceRemainingRatio}" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding RemainingDisplay}" FontSize="17" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                        <TextBlock Text="QUOTA" FontSize="7.5" Foreground="#94B4C7D6" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Margin="0,5,0,5" Padding="9,7" Background="#12FFFFFF"
                                BorderBrush="#36FFFFFF" BorderThickness="1" CornerRadius="16">
                            <Grid>
                                <controls:TokenPulseChart Values="{Binding Pulse}" />
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Padding="7,2"
                                        CornerRadius="8" Background="#30152537" BorderBrush="#42FFFFFF" BorderThickness="1">
                                    <TextBlock Text="5 MIN PULSE" FontSize="7.5" FontWeight="SemiBold" Foreground="#C8DFECF6" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CONTEXT" FontSize="8" Foreground="#91B2C5D4" />
                                <ProgressBar Width="62" Margin="7,0,6,0" Style="{StaticResource SmallProgressStyle}"
                                             Value="{Binding ContextRatio, Mode=OneWay}" Maximum="1" />
                                <TextBlock Text="{Binding ContextDisplay}" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource WidgetIconButtonStyle}" ToolTip="打开主界面" AutomationProperties.Name="打开主界面" Click="Open_Click" Content="&#xE8A7;" />
                                <Button x:Name="PinButton" Style="{StaticResource WidgetIconButtonStyle}" Margin="5,0,0,0"
                                        ToolTip="取消置顶" AutomationProperties.Name="切换组件置顶" Click="Pin_Click" Content="&#xE718;" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="CollapsedPanel" Visibility="Collapsed" Margin="-5,-6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="#24FFFFFF" BorderBrush="#8FFFFFFF" BorderThickness="1">
                            <Ellipse Width="13" Height="13" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.8" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="7,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTotalDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="CURRENT TOKENS" FontSize="7.5" Foreground="#91B1C4D3" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding RemainingDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource LimeBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="QUOTA" FontSize="7.5" Foreground="#91B1C4D3" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button Grid.Column="3" Margin="5,0,0,0" Style="{StaticResource WidgetIconButtonStyle}"
                                ToolTip="展开" AutomationProperties.Name="展开桌面组件" Click="Expand_Click" Content="&#xE70E;" />
                    </Grid>
                </Grid>
            </controls:BackdropGlass>
        </Grid>
    </Border>
</Window>
