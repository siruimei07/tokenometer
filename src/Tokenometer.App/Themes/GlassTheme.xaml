<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Tokenometer.Controls">
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons</FontFamily>

    <Color x:Key="InkColor">#F4F8FC</Color>
    <Color x:Key="SecondaryInkColor">#C1CDDA</Color>
    <Color x:Key="AccentColor">#70D7FF</Color>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="SecondaryInkBrush" Color="{StaticResource SecondaryInkColor}" />
    <SolidColorBrush x:Key="TertiaryInkBrush" Color="#8FA0B2" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="#70D7FF" />
    <SolidColorBrush x:Key="MintBrush" Color="#B9EE9B" />
    <SolidColorBrush x:Key="VioletBrush" Color="#B5A2FF" />
    <SolidColorBrush x:Key="CoralBrush" Color="#FF704F" />
    <SolidColorBrush x:Key="LimeBrush" Color="#C9F37A" />
    <SolidColorBrush x:Key="GlassBrush" Color="#36121D2C" />
    <SolidColorBrush x:Key="GlassSoftBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#6B1D2B3B" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="GlassCoolStrokeBrush" Color="#647AD7FF" />
    <SolidColorBrush x:Key="DeepGlassTintBrush" Color="#66101A29" />
    <SolidColorBrush x:Key="MediumGlassTintBrush" Color="#48142031" />
    <SolidColorBrush x:Key="LightGlassTintBrush" Color="#20FFFFFF" />

    <LinearGradientBrush x:Key="LiquidEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#78FFFFFF" Offset="0" />
        <GradientStop Color="#3CFFFFFF" Offset="0.2" />
        <GradientStop Color="#18FFFFFF" Offset="0.56" />
        <GradientStop Color="#0BFFFFFF" Offset="0.82" />
        <GradientStop Color="#05FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidInnerHighlightBrush" StartPoint="0,0" EndPoint="0.88,1">
        <GradientStop Color="#C8FFFFFF" Offset="0" />
        <GradientStop Color="#48FFFFFF" Offset="0.27" />
        <GradientStop Color="#10FFFFFF" Offset="0.72" />
        <GradientStop Color="#02FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Neutral density only: the system backdrop supplies every visible hue. -->
    <SolidColorBrush x:Key="LiquidRegularTintBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="LiquidContentTintBrush" Color="#06FFFFFF" />

    <Style x:Key="LiquidGlassSurfaceStyle" TargetType="controls:BackdropGlass">
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="BlurRadius" Value="20" />
        <Setter Property="LensWidth" Value="12" />
        <Setter Property="RefractionDepth" Value="8" />
        <Setter Property="RefractionOpacity" Value="0.86" />
        <Setter Property="PointerGlowOpacity" Value="0.09" />
        <Setter Property="TintBrush" Value="{StaticResource LiquidRegularTintBrush}" />
        <Setter Property="SaturationTint" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource LiquidEdgeBrush}" />
        <Setter Property="BorderThickness" Value="0.42" />
        <Setter Property="HighlightBrush" Value="{StaticResource LiquidInnerHighlightBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#020507" BlurRadius="46" ShadowDepth="16" Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LiquidContentSurfaceStyle"
           TargetType="controls:BackdropGlass"
           BasedOn="{StaticResource LiquidGlassSurfaceStyle}">
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="BlurRadius" Value="14" />
        <Setter Property="LensWidth" Value="6" />
        <Setter Property="RefractionDepth" Value="3.2" />
        <Setter Property="RefractionOpacity" Value="0.52" />
        <Setter Property="PointerGlowOpacity" Value="0.06" />
        <Setter Property="TintBrush" Value="{StaticResource LiquidContentTintBrush}" />
        <Setter Property="SaturationTint" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0.3" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#020507" BlurRadius="24" ShadowDepth="8" Opacity="0.2" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LiquidCapsuleSurfaceStyle"
           TargetType="controls:BackdropGlass"
           BasedOn="{StaticResource LiquidGlassSurfaceStyle}">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="BlurRadius" Value="20" />
        <Setter Property="LensWidth" Value="7" />
        <Setter Property="RefractionDepth" Value="2.8" />
        <Setter Property="RefractionOpacity" Value="0.7" />
        <Setter Property="TintBrush" Value="#16FFFFFF" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#020711" BlurRadius="22" ShadowDepth="7" Opacity="0.28" />
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="CanvasBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#101B2C" Offset="0" />
        <GradientStop Color="#13283A" Offset="0.56" />
        <GradientStop Color="#0B1625" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#35182635" Offset="0" />
        <GradientStop Color="#24151F2D" Offset="0.45" />
        <GradientStop Color="#40111B2A" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#030811" BlurRadius="22" ShadowDepth="6" Opacity="0.24" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassHoverBrush}" />
                <Setter Property="BorderBrush" Value="#A8FFFFFF" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#030811" BlurRadius="28" ShadowDepth="8" Opacity="0.32" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassInnerStyle" TargetType="Border">
        <Setter Property="Background" Value="#18FFFFFF" />
        <Setter Property="BorderBrush" Value="#42FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="15" />
    </Style>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryInkBrush}" />
        <Setter Property="Background" Value="#18FFFFFF" />
        <Setter Property="BorderBrush" Value="#46FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding Tag}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#38FFFFFF" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#9AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Tag" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Tag" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccentPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource CoralBrush}" />
        <Setter Property="BorderBrush" Value="#B8FFD6CB" />
    </Style>

    <Style x:Key="SidebarRadioStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryInkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Lens" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="Dot" Width="4" Height="16" HorizontalAlignment="Left" Margin="-10,0,0,0"
                                Background="{StaticResource AccentBrush}" CornerRadius="2" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Lens" Property="Background" Value="#24FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Lens" Property="Background" Value="#3AFFFFFF" />
                            <Setter TargetName="Lens" Property="BorderBrush" Value="#86FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Lens" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Tag" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryInkBrush}" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style x:Key="SmallProgressStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="7" />
        <Setter Property="Background" Value="#48747F99" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
